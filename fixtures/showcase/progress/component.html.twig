<section data-controller="__CONTROLLER__" data-__CONTROLLER__-start-value="{{ start }}" data-__CONTROLLER__-auto-start-value="{{ autoStart ? 'true' : 'false' }}" class="rounded-box border border-base-300 p-5"><h2 class="font-semibold">{{ label }}</h2><progress class="progress progress-primary mt-3 w-full" aria-label="{{ label }}" value="{{ start }}" max="100" data-__CONTROLLER__-target="bar"></progress><output data-__CONTROLLER__-target="value">{{ start }}%</output><div class="mt-3 flex gap-2"><button type="button" class="btn btn-sm" data-action="__CONTROLLER__#advance">Advance progress</button><button type="button" class="btn btn-sm" data-action="__CONTROLLER__#reset">Reset progress</button><button type="button" class="btn btn-sm" data-action="__CONTROLLER__#toggle" data-__CONTROLLER__-target="toggle">Pause progress</button></div><p class="mt-3 text-sm">Local demonstration values. Automatic updates pause for reduced motion.</p></section>
