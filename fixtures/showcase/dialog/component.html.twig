<section data-controller="__CONTROLLER__"><button type="button" class="btn btn-outline" data-action="__CONTROLLER__#open">Open dialog</button><dialog class="modal" data-__CONTROLLER__-target="dialog"><div class="modal-box"><h2 class="text-lg font-semibold" data-__CONTROLLER__-target="title">{{ title }}</h2><p class="py-4">{{ content }}</p><button type="button" class="btn" data-action="__CONTROLLER__#close">Close dialog</button></div></dialog></section>
