{
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "tone": {
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "dismissible": {
      "type": "boolean"
    },
    "dismissLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "message",
    "tone",
    "dismissible",
    "dismissLabel"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
