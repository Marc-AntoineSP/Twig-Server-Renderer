APP_ENV=prod
APP_DEBUG=0
APP_SHARE_DIR=var/share
APP_SECRET_FILE=/run/secrets/app_secret
DATABASE_URL_FILE=/run/secrets/database_url
RENDER_WORKER_TOKEN_FILE=/run/secrets/render_token
BUILD_WORKER_TOKEN_FILE=/run/secrets/build_token
RENDER_WORKER_URL=http://render-worker:8080
BUILD_WORKER_URL=http://build-worker:8080
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
LOCK_DSN=flock
DEFAULT_URI=http://localhost:8096
TRUSTED_PROXIES=
TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|studio|app)$'
