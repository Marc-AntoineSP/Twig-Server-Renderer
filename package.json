{
  "name": "styleguide-studio-toolchain",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/styles/studio.input.css -o ./assets/styles/app.css --minify && npm run build:showcase",
    "build:showcase": "esbuild ./fixtures/theme-showcase/bootstrap.js --bundle --format=esm --external:@hotwired/stimulus --target=es2022 --minify --outfile=./assets/showcase/showcase.js",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@hotwired/stimulus": "3.2.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "daisyui": "5.7.50",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
