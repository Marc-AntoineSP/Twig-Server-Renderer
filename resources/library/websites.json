      "surface": "Primer product UI design tokens",
      "hosts": [
        "primer.style"
      ],
      "modes": [
        "light",
        "dark"
      ],
      "fonts": {
        "body": "system-sans",
        "heading": "system-sans",
        "code": "jetbrains-mono"
      },
      "variables": [
        "--bgColor-default",
        "--bgColor-muted",
        "--bgColor-inset",
        "--fgColor-default",
        "--bgColor-accent-emphasis",
        "--bgColor-success-emphasis",
        "--bgColor-danger-emphasis",
        "--bgColor-attention-emphasis",
        "--borderRadius-medium"
      ],
      "selectors": {
        "body": "body",
        "heading": "h1",
        "surface": "main",
        "action": "main a[href], main button, a[href], button",
        "field": "input, select",
        "card": "article, section",
        "code": "code, pre"
      },
      "attribution": "Independent design observations from GitHub official public sources; no brand assets or proprietary font binaries redistributed. Source colours are mapped/adapted to daisyUI semantics; no endorsement.",
      "attributes": {
        "light": {
          "data-color-mode": "light",
          "data-light-theme": "light"
        },
        "dark": {
          "data-color-mode": "dark",
          "data-dark-theme": "dark"
        }
      },
      "mapping": {
        "base-100": [
          "token:--bgColor-default"
        ],
        "base-200": [
          "token:--bgColor-muted"
        ],
        "base-300": [
          "token:--bgColor-inset"
        ],
        "base-content": [
          "token:--fgColor-default"
        ],
        "primary": [
          "token:--bgColor-success-emphasis"
        ],
        "secondary": [
          "token:--bgColor-accent-emphasis"
        ],
        "accent": [
          "token:--bgColor-attention-emphasis"
        ],
        "info": [
          "token:--bgColor-accent-emphasis"
        ],
        "success": [
          "token:--bgColor-success-emphasis"
        ],
        "warning": [
          "token:--bgColor-attention-emphasis"
        ],
        "error": [
          "token:--bgColor-danger-emphasis"
        ]
      }
    },
