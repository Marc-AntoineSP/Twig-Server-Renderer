{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "registry": {
            "type": "string",
            "minLength": 1
          },
          "archiveSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
                  "maxLength": 100
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "installedFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.\\-/]+$",
                  "maxLength": 240
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          },
          "managedEdits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.\\-/]+$",
                  "maxLength": 240
                },
                "marker": {
                  "type": "string"
                },
                "beforeSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "afterSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "marker",
                "beforeSha256",
                "afterSha256"
              ],
              "additionalProperties": false
            },
            "maxItems": 500
          }
        },
        "required": [
          "name",
          "version",
          "registry",
          "archiveSha256",
          "dependencies",
          "installedFiles",
          "managedEdits"
        ],
        "additionalProperties": false
      },
      "maxItems": 500
    }
  },
  "required": [
    "schemaVersion",
    "packages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
