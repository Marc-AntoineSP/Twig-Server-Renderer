{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "cssName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "colorScheme": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "default": {
      "type": "boolean"
    },
    "prefersDark": {
      "type": "boolean"
    },
    "colors": {
      "type": "object",
      "properties": {
        "base-100": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "base-200": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "base-300": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "base-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "primary-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "neutral": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "neutral-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "info": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "info-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "success-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "warning-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "error-content": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "base-100",
        "base-200",
        "base-300",
        "base-content",
        "primary",
        "primary-content",
        "secondary",
        "secondary-content",
        "accent",
        "accent-content",
        "neutral",
        "neutral-content",
        "info",
        "info-content",
        "success",
        "success-content",
        "warning",
        "warning-content",
        "error",
        "error-content"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "radiusSelectorRem": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "radiusFieldRem": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "radiusBoxRem": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "sizeSelectorRem": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 1
        },
        "sizeFieldRem": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 1
        },
        "borderPx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "depth": {
          "enum": [
            0,
            1
          ]
        },
        "noise": {
          "enum": [
            0,
            1
          ]
        },
        "highContrastBorders": {
          "type": "boolean"
        }
      },
      "required": [
        "radiusSelectorRem",
        "radiusFieldRem",
        "radiusBoxRem",
        "sizeSelectorRem",
        "sizeFieldRem",
        "borderPx",
        "depth",
        "noise"
      ],
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "properties": {
        "bodyFontId": {
          "type": "string"
        },
        "headingFontId": {
          "type": "string"
        },
        "textClass": {
          "enum": [
            "text-xs",
            "text-sm",
            "text-base",
            "text-lg",
            "text-xl"
          ]
        },
        "rootFontSizePx": {
          "type": "integer",
          "minimum": 12,
          "maximum": 24
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        },
        "codeFontId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "bodyWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "bodyStyle": {
          "enum": [
            "normal",
            "italic"
          ]
        },
        "headingWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "headingStyle": {
          "enum": [
            "normal",
            "italic"
          ]
        },
        "codeWeight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000
        },
        "codeStyle": {
          "enum": [
            "normal",
            "italic"
          ]
        }
      },
      "required": [
        "bodyFontId",
        "headingFontId",
        "textClass",
        "rootFontSizePx",
        "lineHeight"
      ],
      "additionalProperties": false
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "system",
              "local"
            ]
          },
          "family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9 -]+$",
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.\\-/]+$",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "enum": [
              "sans",
              "serif",
              "mono",
              "display"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 500
          },
          "sourceVersion": {
            "type": "string",
            "maxLength": 50
          },
          "licensePath": {
            "type": "string",
            "pattern": "^licenses/[a-z][a-z0-9-]*\\.txt$",
            "maxLength": 120
          },
          "licenseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "faces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^fonts/[a-f0-9]{64}\\.woff2$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 48,
                  "maximum": 1048576
                },
                "weightMin": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 1000
                },
                "weightMax": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 1000
                },
                "style": {
                  "enum": [
                    "normal",
                    "italic"
                  ]
                },
                "subset": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "maxLength": 40
                },
                "unicodeRange": {
                  "type": "string",
                  "pattern": "^U\\+[0-9A-Fa-f]{1,6}(?:-[0-9A-Fa-f]{1,6})?(?:,U\\+[0-9A-Fa-f]{1,6}(?:-[0-9A-Fa-f]{1,6})?)*$",
                  "maxLength": 2500
                },
                "axes": {
                  "type": "object",
                  "maxProperties": 10,
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9]{4}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "default": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "min",
                      "max",
                      "default"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "path",
                "sha256",
                "bytes",
                "weightMin",
                "weightMax",
                "style",
                "subset",
                "unicodeRange",
                "axes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "family"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "provenance": {
      "type": "object",
      "properties": {
        "collection": {
          "const": "website-inspired"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "reference": {
          "type": "string",
          "maxLength": 80
        },
        "surface": {
          "type": "string",
          "maxLength": 200
        },
        "modeOrigin": {
          "enum": [
            "observed",
            "derived"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "maxLength": 40
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 800
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "method": {
                "type": "string",
                "maxLength": 200
              },
              "attribution": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "url",
              "sha256",
              "method",
              "attribution"
            ],
            "additionalProperties": false
          }
        },
        "values": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "observed",
                  "adapted",
                  "derived"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 400
              },
              "observed": {
                "type": [
                  "string",
                  "number",
                  "null"
                ],
                "maxLength": 2000
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ],
                "maxLength": 2000
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "source",
              "observed",
              "value",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "fontSubstitutions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "body",
                  "heading",
                  "code"
                ]
              },
              "observed": {
                "type": "string",
                "maxLength": 1000
              },
              "selected": {
                "type": "string",
                "maxLength": 80
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "role",
              "observed",
              "selected",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "omitted": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "managed": {
          "type": "boolean"
        }
      },
      "required": [
        "collection",
        "slug",
        "title",
        "reference",
        "surface",
        "modeOrigin",
        "retrievedAt",
        "sources",
        "values",
        "fontSubstitutions",
        "omitted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "version",
    "cssName",
    "colorScheme",
    "default",
    "prefersDark",
    "colors",
    "geometry",
    "typography",
    "fonts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Local WOFF2 metadata is backward compatible; byte validation and package-local file inventory are enforced by shared validators."
}
