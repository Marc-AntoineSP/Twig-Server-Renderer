{% extends 'base.html.twig' %}
{% block title %}Compose {{ item.name }}{% endblock %}
{% block body %}
<section data-controller="composition" data-composition-history-url-value="{{ path('composition_history', {id:item.id}) }}" data-composition-restore-url-value="{{ path('composition_restore', {id:item.id}) }}" data-action="favorite:changed@document->composition#favoriteChanged" data-composition-tree-value="{{ document|json_encode|e('html_attr') }}" data-composition-choices-value="{{ choices|json_encode|e('html_attr') }}" data-composition-revision-value="{{ draft.revision }}" data-composition-item-value="{{ item.id }}" data-composition-commands-url-value="{{ path('composition_commands', {id: item.id}) }}" data-composition-read-url-value="{{ path('composition_read', {id: item.id}) }}" data-composition-url-value="{{ path('composition_save', {id: item.id}) }}" data-composition-csrf-value="{{ csrf_token('api') }}" data-composition-create-url-value="{{ path('preview_create') }}" data-composition-status-url-value="{{ path('preview_status', {id: '__JOB__'}) }}" data-composition-document-url-value="{{ path('preview_document', {id: '__JOB__'}) }}" data-composition-settings-value="{{ rendererSettings|json_encode|e('html_attr') }}" data-composition-themes-value="{{ themeChoices|json_encode|e('html_attr') }}" data-composition-preset-url-value="{{ path('renderer_preset_save', {id: item.id}) }}">
<div class="flex flex-wrap items-center justify-between gap-3"><div><p class="font-mono text-sm">{{ item.name }} · {{ item.kind }} · composition mode</p><div class="flex items-center gap-2"><h1 class="text-3xl font-bold">Composition builder</h1>{% include 'favorites/_button.html.twig' with {kind: 'catalogue'} %}</div></div><a class="link" href="{{ path('catalogue_show', {id: item.id, returnTo: listing_return('catalogue_index')}) }}">Releases and exports</a></div>
<p class="my-4">The tree owns generated Twig and exact dependencies. Select nodes with arrow keys; use the labelled buttons to reorder, nest, duplicate and remove them.</p>
<label for="composition-title">Title</label><input id="composition-title" class="input w-full" value="{{ item.title }}" data-composition-target="title" data-action="input->composition#metadata">
<div class="my-4 flex flex-wrap gap-2"><button class="btn btn-primary" type="button" data-action="composition#save">Save composition</button><button class="btn btn-outline" type="button" data-action="composition#openHistory">Saved history</button><span role="status" data-composition-target="saveStatus">Saved revision {{ draft.revision }}</span></div>
{% include 'composition/_history.html.twig' %}
<div hidden class="alert alert-warning my-4" role="status" data-composition-target="externalNotice"><span data-composition-target="externalMessage"></span><button type="button" class="btn btn-sm btn-outline" data-action="composition#loadSaved">Load saved revision</button></div>
<div class="grid gap-5 md:grid-cols-2">
<div class="rounded border border-base-300 bg-base-100 p-4"><h2 class="font-semibold">Tree</h2>
<div class="my-3 space-y-2"><label class="flex items-center gap-2"><input type="checkbox" class="checkbox checkbox-sm" data-composition-target="favoritesOnly" data-action="change->composition#filterChoices"> Favorites only</label><label for="insert-reference">Component, block or layout to insert</label><select id="insert-reference" class="select w-full" data-composition-target="insertReference"></select><p class="text-sm" role="status" data-composition-target="pickerStatus"></p><p class="text-xs">Only published immutable references are eligible. Favorites never change the saved tree.</p></div>
<div class="my-3 flex flex-wrap gap-2"><button class="btn btn-sm" type="button" data-action="composition#addContainer">Add container</button><button class="btn btn-sm" type="button" data-action="composition#addText">Add text</button><button class="btn btn-sm" type="button" data-action="composition#addReference">Add reference</button></div>
<div role="tree" aria-label="Composition tree" data-composition-target="rows"></div>
<div class="my-3 flex flex-wrap gap-2">{% for action, label in {'up':'Move up','down':'Move down','indent':'Indent','outdent':'Outdent','duplicate':'Duplicate node','remove':'Remove node'} %}<button class="btn btn-outline btn-sm" type="button" data-action="composition#{{ action }}">{{ label }}</button>{% endfor %}</div>
</div>
<div class="rounded border border-base-300 bg-base-100 p-4"><h2 class="mb-3 font-semibold">Selected node</h2>
<div data-composition-target="containerFields"><label for="node-tag">Container tag</label><select id="node-tag" class="select w-full" data-composition-target="tag" data-action="change->composition#fields">{% for tag in ['div','section','article','header','footer','main','aside','nav'] %}<option>{{ tag }}</option>{% endfor %}</select><label for="node-classes">Literal utility classes</label><input id="node-classes" class="input w-full" data-composition-target="classes" data-action="input->composition#fields"></div>
<div data-composition-target="textFields"><label for="node-text">Literal text</label><textarea id="node-text" class="textarea w-full" rows="5" data-composition-target="text" data-action="input->composition#fields"></textarea></div>
<div data-composition-target="referenceFields"><label for="node-reference">Immutable reference</label><select id="node-reference" class="select w-full" data-composition-target="reference" data-action="change->composition#referenceChanged">{% for choice in choices %}<option value="{{ loop.index0 }}">{{ choice.label }}</option>{% endfor %}</select><label for="node-props">Instance props (JSON)</label><textarea id="node-props" class="textarea w-full font-mono" rows="8" data-composition-target="props" data-action="input->composition#fields"></textarea></div>
</div></div>
<h2 class="mt-6 text-xl font-semibold">Preview</h2>
<div class="my-3 grid gap-3 sm:grid-cols-2">
<div><label for="composition-theme">Published theme</label><select id="composition-theme" class="select w-full" data-composition-target="theme" data-action="change->composition#themeChanged"><option value="">Package default (studio light if absent)</option>{% for id, choice in themeChoices %}<option value="{{ id }}">{{ choice.label }}</option>{% endfor %}</select></div>
{% for key, label in {bodyFont: 'Body font', headingFont: 'Heading font', codeFont: 'Code font'} %}<div><label for="composition-{{ key }}">{{ label }}</label><select id="composition-{{ key }}" class="select w-full" data-composition-target="{{ key }}" data-action="change->composition#schedule"><option value="system-sans">System sans</option><option value="system-serif">System serif</option><option value="system-mono">System monospace</option><option value="theme">Theme default</option>{% for id,font in fontFamilies %}<option value="{{ id }}">{{ font.family }}</option>{% endfor %}</select></div>{% endfor %}
</div>
<p class="text-sm">Renderer choices are saved separately from the composition. Set a theme's weights and styles in the theme editor.</p>
<div class="my-3 flex flex-wrap gap-2">{% for width in [375,768,1280] %}<button class="btn btn-sm" type="button" data-width="{{ width }}" data-action="composition#width">{{ width }} px</button>{% endfor %}<button class="btn btn-outline btn-sm" type="button" data-action="composition#preview">Build preview</button><button class="btn btn-outline btn-sm" type="button" data-action="composition#reset">Reset iframe</button><button class="btn btn-outline btn-sm" type="button" data-action="composition#savePreset">Save renderer settings</button><span role="status" data-composition-target="presetStatus"></span><label><input type="checkbox" data-composition-target="disableJs" data-action="change->composition#schedule"> Disable preview JavaScript</label></div>
<p role="status" data-composition-target="status">Preparing preview…</p><div class="mt-3 overflow-x-auto"><iframe title="Composition preview" sandbox="allow-scripts" style="width:768px;height:300px" class="border border-base-300" data-composition-target="frame"></iframe></div>
<details class="my-6"><summary>Generated Twig (read-only)</summary><textarea class="textarea mt-3 w-full font-mono" rows="10" readonly aria-label="Generated Twig" data-composition-target="generated">{{ generatedTwig }}</textarea></details>
</section>
<section class="mt-6 rounded border border-base-300 p-4"><h2 class="text-xl font-semibold">Duplicate and convert to source</h2><p class="my-3">Creates a separate source-owned item. The original composition stays editable as a tree. The new source item has no visual builder.</p><form action="{{ path('composition_convert', {id: item.id}) }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('convert-source') }}"><label for="convert-name">New source name (namespace/slug)</label><input id="convert-name" name="name" required pattern="[a-z][a-z0-9-]*/[a-z][a-z0-9-]*"><button class="btn btn-outline mt-3" type="submit">Duplicate and convert to source</button></form></section>
{% endblock %}
