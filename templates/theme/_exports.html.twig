<p class="my-2 text-sm">app.css is a complete Tailwind source entry for a fresh project. Merge the fragment and typography into an existing entry once. preview.css is compiled for the sample; it does not cover every possible utility.</p>
<div class="flex flex-wrap gap-3">{% for file, label in {'app.css': 'app.css (source)', 'theme.fragment.css': 'Theme fragment (source)', 'typography.css': 'Typography (source)', 'preview.css': 'preview.css (compiled)', 'theme.json': 'theme.json', 'bundle.zip': 'Output bundle ZIP'} %}<a class="link" href="{{ path(route, {id: id, file: file}) }}">{{ label }}</a>{% endfor %}</div>
