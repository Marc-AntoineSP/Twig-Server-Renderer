{% macro card(id, title, keywords = '') %}
<article class="{{ id in ['tables', 'navbar', 'heroes', 'footers', 'browser', 'code'] ? 'showcase-wide ' : '' }}rounded-box border border-base-300 bg-base-100 p-4 sm:p-5" data-showcase-card data-component="{{ id }}" data-search="{{ (title~' '~keywords)|lower }}" aria-labelledby="component-{{ id }}"><h4 id="component-{{ id }}" class="font-semibold">{{ title }}</h4>
{% endmacro %}

{% macro icon(name) %}
<svg aria-hidden="true" class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">{% if name == 'home' %}<path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/>{% elseif name == 'mail' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>{% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>{% elseif name == 'menu' %}<path d="M4 6h16M4 12h16M4 18h16"/>{% else %}<circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3v1"/>{% endif %}</svg>
{% endmacro %}
