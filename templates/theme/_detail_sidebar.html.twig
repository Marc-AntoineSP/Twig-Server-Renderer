<aside class="min-w-0" data-theme-sidebar aria-label="Theme details">
    <details data-controller="theme-details" data-theme-details-target="disclosure" class="theme-details rounded-box border border-base-300 bg-base-100">
        <summary class="cursor-pointer p-4 font-semibold focus-visible:outline" data-theme-details-target="summary">Theme details <span class="block text-sm font-normal">{{ theme.document.provenance.title|default(theme.name) }}</span></summary>
        <div class="min-w-0 space-y-5 p-4">
            <header><a class="link mb-3 inline-block text-sm" href="{{ listing_return('theme_index') }}">← Themes</a>
                <p class="mb-2 text-sm">{{ theme.document.colorScheme|capitalize }} theme</p>
                <div class="flex items-start justify-between gap-2"><h1 class="min-w-0 text-2xl font-bold">{{ theme.document.provenance.title|default(theme.name) }}</h1>{% include 'favorites/_button.html.twig' with {kind: 'theme', item: theme} %}</div>
                <dl class="mt-3 space-y-1 text-sm">
                    <div><dt class="inline font-semibold">Family:</dt> <dd class="inline">{{ family.label }}</dd></div>
                    <div><dt class="inline font-semibold">Name:</dt> <dd class="inline">{{ theme.name }}</dd></div>
                    <div><dt class="inline font-semibold">Draft revision:</dt> <dd class="inline">{{ theme.revision }}</dd></div>
                    <div><dt class="inline font-semibold">Proposed version:</dt> <dd class="inline">{{ theme.document.version }}</dd></div>
                </dl>
            </header>
            <section aria-label="Theme actions" class="space-y-2">
                <button type="button" class="btn btn-primary w-full" data-action="appearance#applyTheme" data-theme-id="{{ theme.id }}" data-theme-revision="{{ theme.revision }}">Apply theme</button>
                <span hidden class="badge badge-success" data-appearance-target="applied" data-family-id="{{ family.id }}" data-variant-mode="{{ theme.document.colorScheme }}">Applied</span>
                {% if is_granted('ROLE_EDITOR') %}
                    {% if not family.builtIn and not theme.document.provenance.managed|default(false) %}<a class="btn btn-outline w-full" href="{{ path('theme_edit', {id: theme.id, returnTo: listing_return('theme_index')}) }}">Edit theme</a>{% endif %}
                    <form method="post" action="{{ path('theme_duplicate', {id: theme.id}) }}" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('theme-duplicate') }}"><button type="submit" class="btn btn-outline w-full">Duplicate/Edit</button></form>
                    {% if releases|length %}<form method="post" action="{{ path('theme_apply', {id: theme.id}) }}" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('theme-apply') }}"><button type="submit" class="btn btn-outline w-full">Apply to showcase</button></form>{% endif %}
                {% endif %}
            </section>
            <nav aria-label="Showcase theme variant">
                <h2 class="mb-2 font-semibold">Light / dark variants</h2>
                <div class="flex flex-wrap gap-2">{% for mode, variant in family.variants %}<a class="btn btn-sm {{ mode == theme.document.colorScheme ? 'btn-primary' : 'btn-outline' }}" href="{{ path('theme_show', {id: variant.id, returnTo: listing_return('theme_index')}) }}#component-showcase" {% if variant.id == theme.id %}aria-current="page"{% endif %}>Showcase {{ mode }}</a>{% endfor %}</div>
                <p class="mt-2 text-sm">Browse a variant here. Apply theme saves it as your application appearance.</p>
            </nav>
            {% if theme.document.provenance is defined %}
                {% include 'theme/_provenance.html.twig' with {compact: true} %}
            {% endif %}
            <details class="border-t border-base-300 pt-3">
                <summary class="cursor-pointer font-semibold">Semantic text contrast</summary>
                <p class="my-3 text-sm">Solid sRGB token pairs. Focus, hover, selected, disabled and error states need separate visual checks.</p>
                <div class="overflow-x-auto"><table class="table table-xs"><thead><tr><th>Background / content</th><th>Ratio</th></tr></thead><tbody>{% for pair,ratio in ratios %}<tr><td>{{ pair }}</td><td>{{ ratio }}:1</td></tr>{% endfor %}</tbody></table></div>
            </details>
            <details class="border-t border-base-300 pt-3" data-theme-downloads>
                <summary class="cursor-pointer font-semibold">Draft downloads</summary>
                {% include 'theme/_exports.html.twig' with {route: 'theme_export', id: theme.id} %}
                <a class="link mt-3 inline-block" href="{{ path('theme_export', {id: theme.id, file: 'theme.yaml'}) }}">theme.yaml</a>
            </details>
            <details class="border-t border-base-300 pt-3" data-theme-releases>
                <summary class="cursor-pointer font-semibold">Immutable releases <span class="badge badge-sm">{{ releases|length }}</span></summary>
                {% for release in releases %}
                    <article class="my-4 border-t border-base-300 pt-3">
                        <h3 class="font-semibold">Version {{ release.version }}</h3>
                        {% include 'theme/_exports.html.twig' with {route: 'theme_release_export', id: release.id} %}
                        {% if is_granted('ROLE_EDITOR') %}
                            <div class="mt-4" data-controller="theme-package" data-theme-package-url-value="{{ path('theme_package_publish', {id: release.id}) }}" data-theme-package-csrf-value="{{ csrf_token('api') }}" data-theme-package-source-url-value="{{ path('release_source_download', {id: '__RELEASE__'}) }}">
                                <button class="btn btn-outline h-auto min-h-10 w-full whitespace-normal py-2" type="button" data-action="theme-package#publish">Publish package {{ release.version }} to private registry</button>
                                <p role="status" class="my-2" data-theme-package-target="status"></p>
                                <a hidden class="link" data-theme-package-target="link">Download immutable theme package</a>
                            </div>
                        {% endif %}
                    </article>
                {% else %}<p class="my-3 text-sm">No published theme release.</p>{% endfor %}
            </details>
        </div>
    </details>
</aside>
