{% extends 'base.html.twig' %}
{% block title %}{{ theme.name }} · Themes{% endblock %}
{% block main_class %}w-full min-w-0 px-4 py-6 sm:px-6 xl:px-8{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    {% if showcase %}<link rel="stylesheet" href="{{ path('theme_showcase_css', {id: theme.id, hash: showcase.hash}) }}" integrity="{{ showcase.integrity }}" crossorigin="anonymous" data-showcase-stylesheet data-turbo-track="dynamic">{% endif %}
{% endblock %}
{% block body %}
    {% set family = theme_family(theme) %}
    <div class="grid min-w-0 items-start gap-6 lg:grid-cols-[300px_minmax(0,1fr)]" data-theme-detail-layout>
        {% include 'theme/_detail_sidebar.html.twig' %}
        <div class="min-w-0" data-showcase-column>
            {% if showcase %}
                {% include 'theme/showcase/_catalogue.html.twig' with showcase only %}
            {% else %}
                <section id="component-showcase" aria-labelledby="component-showcase-heading"><h2 id="component-showcase-heading" class="mb-4 text-2xl font-semibold">Component showcase</h2><p class="alert alert-warning" role="alert">{{ showcaseError }}</p></section>
            {% endif %}
        </div>
    </div>
{% endblock %}
