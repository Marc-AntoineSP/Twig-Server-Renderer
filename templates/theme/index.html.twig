{% extends 'base.html.twig' %}
{% block title %}Themes · Styleguide Studio{% endblock %}
{% block body %}
{% set filters = {q: query.q, mode: query.mode, sort: query.sort, favorites: query.favorites ? 1 : 0} %}
<div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-bold">Theme laboratory</h1>
{% if is_granted('ROLE_EDITOR') %}<div class="flex gap-3"><a class="btn btn-outline" href="{{ path('theme_import') }}">Import theme</a><a class="btn btn-primary" href="{{ path('theme_new') }}">Create theme</a></div>{% endif %}</div>
<p class="my-4">Typed colours, geometry and typography, with isolated comparison previews and immutable releases.</p>
<p class="my-3 text-sm">{{ 'theme.actions.gallery_help'|trans }}</p>
<section><form method="get" action="{{ path('theme_index') }}" class="my-5 flex flex-wrap items-end gap-4 rounded-box border border-base-300 bg-base-100 p-4" role="search">
<label>Search themes <input type="search" name="q" value="{{ query.q }}" maxlength="120" data-theme-gallery-target="search"></label>
<label>Mode <select name="mode" data-theme-gallery-target="mode"><option value="">All modes</option>{% for mode in ['light','dark'] %}<option value="{{ mode }}" {{ query.mode == mode ? 'selected' : '' }}>{{ mode|capitalize }}</option>{% endfor %}</select></label>
<label>Sort <select name="sort"><option value="updated" {{ query.sort == 'updated' ? 'selected' : '' }}>Recently updated</option><option value="name" {{ query.sort == 'name' ? 'selected' : '' }}>Name</option></select></label>
{% include 'favorites/_filter.html.twig' with {route: 'theme_index'} %}<button type="submit" class="btn btn-neutral">Find themes</button>
</form><p class="mb-4 text-sm" role="status">{{ total }} {{ total == 1 ? 'theme' : 'themes' }} · Page {{ page }} of {{ pages }}</p>
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{% for theme in themes %}{% set doc = theme.document %}{% set provenance = doc.provenance|default(null) %}<article class="card min-w-0 border border-base-300 bg-base-100 p-5" data-theme-gallery-target="card" data-name="{{ (provenance ? provenance.title : theme.name)|lower }}" data-mode="{{ doc.colorScheme }}" data-theme-id="{{ theme.id }}">
{% set family = theme_family(theme) %}<div class="flex items-start justify-between gap-2"><h2 class="min-w-0 break-words text-xl font-semibold"><a href="{{ path('theme_show', {id: theme.id, returnTo: app.request.requestUri}) }}">{{ provenance ? provenance.title : theme.name }}</a></h2>{% include 'favorites/_button.html.twig' with {kind: 'theme', item: theme} %}</div><p class="text-sm">Family: {{ family.label }} · {{ family.variants|keys|join(' / ') }}</p><span hidden class="badge badge-success" data-appearance-target="applied" data-family-id="{{ family.id }}" data-variant-mode="{{ doc.colorScheme }}">Applied</span>
{% if provenance %}<p class="my-2 text-sm">{{ provenance.surface }} · {{ provenance.modeOrigin }} mode</p>{% endif %}
<div class="my-3 rounded-box border p-4" style="background:{{ doc.colors.('base-100') }};color:{{ doc.colors.('base-content') }}"><p class="font-semibold">Readable components</p><p>Bonjour, world! 12 € — Œuvre.</p><div class="mt-3 flex gap-2" aria-label="Theme swatches">{% for color in ['primary','secondary','accent','info','success','warning','error'] %}<span class="h-6 w-6 rounded" style="background:{{ doc.colors.(color) }}" title="{{ color }} {{ doc.colors.(color) }}"></span>{% endfor %}</div></div>
<p class="text-sm">{{ doc.colorScheme }} · revision {{ theme.revision }} · {{ doc.version }}{% if provenance and provenance.managed|default(false) %} · Managed preset{% else %} · Editable theme{% endif %}</p>
<p class="mt-2 text-sm">Fonts: {% for font in doc.fonts %}{{ font.family }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% include 'theme/_actions.html.twig' with {sidebar: false, publishedRelease: publishedReleases[theme.id]|default(null), returnTo: app.request.requestUri} %}</article>{% else %}{% include 'favorites/_empty.html.twig' with {type: 'theme', route: 'theme_index'} %}{% endfor %}</div>{% include 'favorites/_pagination.html.twig' with {route: 'theme_index', label: 'Theme'} %}</section>
{% endblock %}
