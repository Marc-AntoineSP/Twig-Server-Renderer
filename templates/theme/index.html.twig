{% extends 'base.html.twig' %}
{% block title %}Themes · Styleguide Studio{% endblock %}
{% block body %}
<div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-bold">Theme laboratory</h1>
{% if is_granted('ROLE_EDITOR') %}<div class="flex gap-3"><a class="btn btn-outline" href="{{ path('theme_import') }}">Import theme</a><a class="btn btn-primary" href="{{ path('theme_new') }}">Create theme</a></div>{% endif %}</div>
<p class="my-4">Typed colours, geometry and typography, with isolated comparison previews and immutable releases.</p>
<p class="my-3 text-sm">Apply theme changes your application's appearance and saves your personal snapshot. Preview showcase selects an independent catalogue preview. Website references are independent adaptations without endorsement; managed presets stay separate from editable copies.</p>
<section data-controller="theme-gallery"><div class="my-4 flex flex-wrap gap-4"><label>Search themes <input type="search" data-theme-gallery-target="search" data-action="input->theme-gallery#filter"></label><label>Mode <select data-theme-gallery-target="mode" data-action="change->theme-gallery#filter"><option value="">All modes</option><option>light</option><option>dark</option></select></label></div>
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{% for theme in themes %}{% set doc = theme.document %}{% set provenance = doc.provenance|default(null) %}<article class="card border border-base-300 bg-base-100 p-5" data-theme-gallery-target="card" data-name="{{ (provenance ? provenance.title : theme.name)|lower }}" data-mode="{{ doc.colorScheme }}" data-theme-id="{{ theme.id }}">
{% set family = theme_family(theme) %}<h2 class="text-xl font-semibold"><a href="{{ path('theme_show', {id: theme.id}) }}">{{ provenance ? provenance.title : theme.name }}</a></h2><p class="text-sm">Family: {{ family.label }} · {{ family.variants|keys|join(' / ') }}</p><span hidden class="badge badge-success" data-appearance-target="applied" data-family-id="{{ family.id }}" data-variant-mode="{{ doc.colorScheme }}">Applied</span>
{% if provenance %}<p class="my-2 text-sm">{{ provenance.surface }} · {{ provenance.modeOrigin }} mode</p>{% endif %}
<div class="my-3 rounded-box border p-4" style="background:{{ doc.colors.('base-100') }};color:{{ doc.colors.('base-content') }}"><p class="font-semibold">Readable components</p><p>Bonjour, world! 12 € — Œuvre.</p><div class="mt-3 flex gap-2" aria-label="Theme swatches">{% for color in ['primary','secondary','accent','info','success','warning','error'] %}<span class="h-6 w-6 rounded" style="background:{{ doc.colors.(color) }}" title="{{ color }} {{ doc.colors.(color) }}"></span>{% endfor %}</div></div>
<p class="text-sm">{{ doc.colorScheme }} · revision {{ theme.revision }} · {{ doc.version }}{% if provenance and provenance.managed|default(false) %} · Managed preset{% else %} · Editable theme{% endif %}</p>
<p class="mt-2 text-sm">Fonts: {% for font in doc.fonts %}{{ font.family }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
<div class="mt-4 flex flex-wrap gap-2"><button class="btn btn-primary" type="button" data-action="appearance#applyTheme" data-theme-id="{{ theme.id }}" data-theme-revision="{{ theme.revision }}">Apply theme</button>{% if is_granted('ROLE_EDITOR') %}{% if provenance and provenance.managed|default(false) %}<form method="post" action="{{ path('theme_apply', {id:theme.id}) }}" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('theme-apply') }}"><button class="btn btn-outline" type="submit">Preview showcase</button></form>{% elseif not family.builtIn %}<a class="btn btn-outline" href="{{ path('theme_edit', {id: theme.id}) }}">Edit theme</a>{% endif %}<form method="post" action="{{ path('theme_duplicate', {id:theme.id}) }}" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('theme-duplicate') }}"><button class="btn btn-outline" type="submit">Duplicate/Edit</button></form>{% endif %}</div></article>{% else %}<p>No themes yet. Create one or import a validated token document.</p>{% endfor %}</div></section>
{% endblock %}
