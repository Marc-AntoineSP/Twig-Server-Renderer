{% extends 'base.html.twig' %}
{% block title %}{{ 'theme.actions.unavailable_title'|trans }} · Themes{% endblock %}
{% block body %}
    <h1 class="text-2xl font-bold">{{ 'theme.actions.unavailable_title'|trans }}</h1>
    <p class="my-4" role="alert">{{ 'theme.actions.missing_release'|trans }}</p>
    <a class="btn btn-primary h-auto whitespace-normal py-2" href="{{ path('theme_show', {id: theme.id}) }}#component-showcase">{{ 'theme.actions.browse'|trans }}</a>
{% endblock %}
