{% extends 'base.html.twig' %}
{% block title %}Registry read tokens{% endblock %}
{% block body %}
<h1 class="text-3xl font-bold">Registry read tokens</h1>
<p class="my-4">Tokens grant package downloads within explicit scopes. They cannot sign into the studio. Store them in a private consumer auth file or environment variable.</p>
{% if plain %}<div class="alert alert-info my-4"><div><p class="font-semibold">Shown once. Copy this read token to private storage.</p><code class="break-all" data-read-token>{{ plain }}</code></div></div>{% endif %}
<form action="{{ path('registry_token_create') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('registry-token') }}"><label for="token-label">Token label</label><input id="token-label" name="label" required maxlength="100"><label for="token-scopes">Package scopes</label><input id="token-scopes" name="scopes" required placeholder="awui/* or namespace/slug"><p class="text-sm">Separate scopes with spaces or commas. * explicitly covers the whole registry.</p><label for="token-days">Expires in days</label><input id="token-days" name="days" type="number" value="30" min="1" max="365" required><button class="btn btn-primary mt-4" type="submit">Create read token</button></form>
<table class="table mt-6"><thead><tr><th>Label</th><th>Scopes</th><th>Expires</th><th>Status</th></tr></thead><tbody>{% for token in tokens %}<tr><td>{{ token.label }}</td><td>{{ token.scopes|join(', ') }}</td><td>{{ token.expiresAt|date('Y-m-d') }}</td><td>{% if token.revokedAt %}Revoked{% elseif not token.active %}Expired or owner disabled{% else %}<form action="{{ path('registry_token_revoke',{id:token.id}) }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('registry-token') }}"><button class="btn btn-outline btn-sm" type="submit">Revoke {{ token.label }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4">No read tokens.</td></tr>{% endfor %}</tbody></table>
{% endblock %}
