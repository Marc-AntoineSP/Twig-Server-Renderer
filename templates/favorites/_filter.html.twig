<div class="flex flex-wrap items-center gap-3 self-end">
    <label class="flex cursor-pointer items-center gap-2"><input class="checkbox checkbox-sm checkbox-primary" type="checkbox" name="favorites" value="1" {{ query.favorites ? 'checked' : '' }}> Favorites only</label>
    {% if query.favorites %}<a class="link text-sm" href="{{ path(route, filters|merge({favorites: 0, page: 1})) }}">Clear favorite filter</a>{% endif %}
</div>
