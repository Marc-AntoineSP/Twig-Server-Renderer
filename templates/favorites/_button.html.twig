{% if kind == 'theme' or item.kind in ['component', 'block', 'layout'] %}
    {% set saved = is_favorite(item) %}
    {% set label = saved ? 'Remove from favorites' : 'Add to favorites' %}
    <span class="inline-flex max-w-full flex-wrap items-center gap-1" data-controller="favorite" data-favorite-url-value="{{ path('favorite_write', {kind: kind, id: item.id}) }}" data-favorite-kind-value="{{ kind }}" data-favorite-id-value="{{ item.id }}" data-favorite-saved-value="{{ saved ? 'true' : 'false' }}" data-favorite-csrf-value="{{ csrf_token('api') }}" data-action="favorite:changed@document->favorite#synchronize favorite:pending@document->favorite#pending">
        <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" aria-label="{{ label }}" aria-pressed="{{ saved ? 'true' : 'false' }}" title="{{ label }} · {{ kind == 'theme' ? item.name ~ ' · ' ~ item.document.colorScheme|capitalize : item.title }}" data-favorite-target="button" data-action="favorite#save">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5" fill="{{ saved ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.7" aria-hidden="true" data-favorite-target="icon"><path stroke-linecap="round" stroke-linejoin="round" d="m12 3 2.78 5.63 6.22.91-4.5 4.38 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.54l6.22-.91L12 3Z"/></svg>
        </button>
        <span class="text-xs text-error" role="status" aria-live="polite" data-favorite-target="status"></span>
    </span>
{% endif %}
