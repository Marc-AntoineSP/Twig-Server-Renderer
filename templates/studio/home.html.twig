{% extends 'base.html.twig' %}
{% block body %}
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">Private component workshop</p>
    <h1 class="mb-6 text-4xl font-bold tracking-tight md:text-5xl">Build a language for your interface.</h1>
    <p class="max-w-2xl text-lg">A catalogue for portable Twig, Tailwind and Stimulus components, blocks and layouts.</p>
    <section class="card mt-10 max-w-2xl border border-base-300 bg-base-100 shadow-sm" data-controller="studio">
        <div class="card-body">
            <h2 class="card-title">Your studio is ready</h2>
            <p>The application and PostgreSQL run in Docker. Assets are served locally through AssetMapper.</p>
            <div class="card-actions mt-3">
                <button type="button" class="btn btn-primary" data-action="studio#toggle" aria-expanded="false" aria-controls="studio-help">About this workshop</button>
            </div>
            <p id="studio-help" class="mt-3" data-studio-target="help" hidden>Source stays in your private catalogue. Rendering and publishing become available after the isolated workers are implemented.</p>
        </div>
    </section>
{% endblock %}
