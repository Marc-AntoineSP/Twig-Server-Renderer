{% extends 'base.html.twig' %}
{% block title %}New item · Styleguide Studio{% endblock %}
{% block body %}
    <a class="link" href="{{ path('catalogue_index') }}">← Catalogue</a>
    <h1 class="mt-4 text-3xl font-bold">Create a catalogue item</h1>
    <div class="mt-6 max-w-3xl rounded-box border border-base-300 bg-base-100 p-6">
        {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
            <div role="alert">{{ form_errors(form) }}</div>
            {{ form_rest(form) }}
            <button type="submit" class="btn btn-primary mt-4">Create draft</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
