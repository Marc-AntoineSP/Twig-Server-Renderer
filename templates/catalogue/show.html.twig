{% extends 'base.html.twig' %}
{% block title %}{{ item.title }} · Styleguide Studio{% endblock %}
{% block body %}
    <a class="link" href="{{ path('catalogue_index') }}">← Catalogue</a>
    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
        <div><p class="font-mono text-sm">{{ item.name }}</p><h1 class="mt-2 text-3xl font-bold">{{ item.title }}</h1><p class="mt-3">{{ item.description }}</p></div>
        {% if is_granted('ROLE_EDITOR') %}<a class="btn btn-primary" href="{{ path('catalogue_edit', {id: item.id}) }}">Edit draft</a>{% endif %}
    </div>
    <div class="mt-5 flex flex-wrap gap-2"><span class="badge badge-outline">{{ item.kind }}</span><span class="badge badge-ghost">Revision {{ draft.revision }}</span>{% for tag in item.tags %}<span class="badge badge-soft">{{ tag }}</span>{% endfor %}</div>
    <section class="my-8 rounded-box border border-base-300 bg-base-100 p-6">
        <h2 class="text-xl font-semibold">Releases</h2>
        {% for release in releases %}<p class="mt-3">{{ release.version }} · {{ release.createdAt|date('Y-m-d') }} · <code>styleguide:require {{ item.name }}@{{ release.version }}</code></p>{% else %}<p class="mt-3">No published releases.</p>{% endfor %}
        {% if is_granted('ROLE_EDITOR') %}<form action="{{ path('release_publish', {id: item.id}) }}" method="post" class="mt-5" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('publish') }}"><input type="hidden" name="revision" value="{{ draft.revision }}"><label for="release-version">Release version</label><input id="release-version" name="version" value="{{ draft.manifestData.version }}" required pattern="[0-9]+\.[0-9]+\.[0-9]+"><p class="my-2 text-sm">Runs isolated render/build validation of defaults and examples. Existing versions cannot be replaced.</p><button class="btn btn-outline" type="submit">Publish release</button></form>{% endif %}
    </section>
    <section>
        <h2 class="mb-4 text-xl font-semibold">Saved source files</h2>
        <p class="mb-4 text-sm">{{ draft.manifestData.dependencies|length }} declared dependencies. Source is displayed as text.</p>
        {% for path, source in sourceFiles %}
            <details class="mb-4 rounded-box border border-base-300 bg-base-100 p-4">
                <summary class="cursor-pointer break-all font-mono text-sm">{{ path }}</summary>
                <pre class="mt-4 overflow-auto whitespace-pre-wrap break-all text-sm"><code>{{ source }}</code></pre>
            </details>
        {% endfor %}
    </section>
{% endblock %}
