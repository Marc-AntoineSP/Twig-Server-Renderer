{% extends 'base.html.twig' %}
{% block title %}{{ item.title }} · Styleguide Studio{% endblock %}
{% block body %}
    <a class="link" href="{{ listing_return('catalogue_index') }}">← Catalogue</a>
    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
        <div><p class="font-mono text-sm">{{ item.name }}</p><div class="mt-2 flex items-center gap-2"><h1 class="text-3xl font-bold">{{ item.title }}</h1>{% include 'favorites/_catalogue_button.html.twig' %}</div><p class="mt-3">{{ item.description }}</p></div>
        {% if is_granted('ROLE_EDITOR') %}<a class="btn btn-primary" href="{{ path('catalogue_edit', {id: item.id, returnTo: listing_return('catalogue_index')}) }}">Edit draft</a>{% endif %}
    </div>
    <div class="mt-5 flex flex-wrap gap-2"><span class="badge badge-outline">{{ item.kind }}</span><span class="badge badge-ghost">Revision {{ draft.revision }}</span>{% for tag in item.tags %}<span class="badge badge-soft">{{ tag }}</span>{% endfor %}</div>
    <section class="my-8 rounded-box border border-base-300 bg-base-100 p-6">
        <h2 class="text-xl font-semibold">Releases</h2>
        {% for release in releases %}
        <article class="mt-5 rounded border border-base-300 p-4" data-controller="package-export" data-package-export-url-value="{{ path('package_export_api') }}" data-package-export-csrf-value="{{ csrf_token('api') }}" data-package-export-release-value="{{ release.id }}">
            <p class="font-semibold">{{ release.version }} · {{ release.createdAt|date('Y-m-d') }}</p><div data-controller="clipboard"><label for="install-{{ release.id }}">Installation command for {{ release.version }}</label><input class="input w-full font-mono" id="install-{{ release.id }}" readonly data-clipboard-target="command" value="php bin/console styleguide:require {{ item.name }}@{{ release.version }} --registry=local"><button class="btn btn-ghost btn-sm" type="button" data-action="clipboard#copy">Copy installation command {{ release.version }}</button><p role="status" data-clipboard-target="status"></p><p class="my-2 text-sm">Configure your private registry as the local alias first. Store its token outside the consumer project.</p></div>
            <a class="link my-3 block" href="{{ path('release_source_download',{id:release.id}) }}">Download immutable source ZIP</a>
            <label for="format-{{ release.id }}">Export format for {{ release.version }}</label><select id="format-{{ release.id }}" class="select my-2 w-full" data-package-export-target="format"><option value="source">Source package ZIP</option><option value="collection">Resolved collection ZIP (complete dependency closure)</option>{% if item.kind != 'theme' %}<option value="static">Static HTML snapshot (compiled CSS/JS)</option>{% endif %}<option value="json">Canonical JSON envelope</option><option value="yaml">YAML envelope</option></select>
            {% if item.kind != 'theme' %}<label for="export-theme-{{ release.id }}">Optional immutable theme for {{ release.version }}</label><select id="export-theme-{{ release.id }}" class="select my-2 w-full" data-package-export-target="theme"><option value="">Release default</option>{% for theme in exportThemes %}<option value="{{ theme.id }}">{{ theme.theme.name }}@{{ theme.version }}</option>{% endfor %}</select><details class="my-2"><summary>Static snapshot props</summary><label for="export-props-{{ release.id }}">Props for {{ release.version }} (JSON)</label><textarea id="export-props-{{ release.id }}" class="textarea w-full font-mono" rows="5" data-package-export-target="props">{{ release.manifestData.defaults|json_encode }}</textarea></details>{% endif %}
            <p class="my-2 text-sm">Source files require consumer compilation. Static snapshots embed compiled assets. Collections include exact archives and licences. Downloads are private and expire after 30 minutes.</p>
            <button class="btn btn-outline" type="button" data-action="package-export#build">Build export {{ release.version }}</button><p role="status" class="my-2 break-all" data-package-export-target="status"></p><a hidden class="link" data-package-export-target="link">Download ready export</a>
        </article>
        {% else %}<p class="mt-3">No published releases.</p>{% endfor %}
        {% if is_granted('ROLE_EDITOR') and item.kind != 'theme' %}<form action="{{ path('release_publish', {id: item.id}) }}" method="post" class="mt-5" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('publish') }}"><input type="hidden" name="revision" value="{{ draft.revision }}"><label for="release-version">Release version</label><input id="release-version" name="version" value="{{ draft.manifestData.version }}" required pattern="[0-9]+\.[0-9]+\.[0-9]+"><p class="my-2 text-sm">Runs isolated render/build validation of defaults and examples. Existing versions cannot be replaced.</p><button class="btn btn-outline" type="submit">Publish release</button></form>{% endif %}
    </section>
    {% if is_granted('ROLE_EDITOR') and item.kind != 'theme' %}<details class="my-5 rounded-box border border-base-300 p-4"><summary>Duplicate draft</summary><form method="post" action="{{ path('catalogue_duplicate',{id:item.id}) }}" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('duplicate') }}"><label for="duplicate-name">New copy name (namespace/slug)</label><input id="duplicate-name" name="name" maxlength="100" required><p class="my-2 text-sm">Copies source and composition ownership, retaining exact dependencies. Original drafts/releases stay unchanged.</p><button class="btn btn-outline" type="submit">Create draft copy</button></form></details>{% endif %}
    <section>
        <h2 class="mb-4 text-xl font-semibold">Saved source files</h2>
        <p class="mb-4 text-sm">{{ draft.manifestData.dependencies|length }} declared dependencies. Source is displayed as text.</p>
        {% for path, source in sourceFiles %}
            <details class="mb-4 rounded-box border border-base-300 bg-base-100 p-4">
                <summary class="cursor-pointer break-all font-mono text-sm">{{ path }}</summary>
                <pre class="mt-4 overflow-auto whitespace-pre-wrap break-all text-sm"><code>{{ source }}</code></pre>
            </details>
        {% endfor %}
    </section>
{% endblock %}
