{% extends 'base.html.twig' %}
{% block title %}Edit {{ item.title }} · Styleguide Studio{% endblock %}
{% block body %}
    <a class="link" href="{{ path('catalogue_show', {id: item.id, returnTo: listing_return('catalogue_index')}) }}">← {{ item.name }}</a>
    <div class="mt-4 flex flex-wrap items-center gap-4"><h1 class="text-3xl font-bold">Edit draft</h1>{% include 'favorites/_button.html.twig' with {kind: 'catalogue'} %}<span class="badge badge-ghost">{{ item.kind }}</span></div>
    <p class="mt-2">Saved revision <span data-saved-revision>{{ draft.revision }}</span> · {{ item.name }}</p>
    <div class="mt-6" data-controller="editor preview"
         data-editor-saved-value="{{ {manifestData: draft.manifestData, sourceMap: draft.sourceMap, title: item.title, description: item.description, tags: item.tags}|json_encode|e('html_attr') }}"
         data-preview-item-id-value="{{ item.id }}" data-preview-csrf-value="{{ csrf_token('api') }}"
         data-preview-create-url-value="{{ path('preview_create') }}"
         data-preview-status-url-value="{{ path('preview_status', {id: '__JOB__'}) }}"
         data-preview-document-url-value="{{ path('preview_document', {id: '__JOB__'}) }}"
         data-preview-preset-url-value="{{ path('renderer_preset_save', {id: item.id}) }}"
         data-preview-settings-value="{{ rendererSettings|json_encode|e('html_attr') }}"
         data-preview-default-props-value="{{ draft.manifestData.defaults|json_encode|e('html_attr') }}"
         data-preview-themes-value="{{ themeChoices|json_encode|e('html_attr') }}"
         data-action="editor:changed->preview#schedule editor:invalid->preview#invalid">
        <div class="grid gap-6 xl:grid-cols-2">
            <section class="min-w-0 rounded-box border border-base-300 bg-base-100 p-5">
                {{ form_start(form, {attr: {'data-turbo': 'false', 'data-action': 'submit->editor#submitting'}}) }}
                    <div role="alert" data-form-errors>{{ form_errors(form) }}</div>
                    <div class="flex items-center justify-between"><h2 class="text-xl font-semibold">Source</h2><span class="badge badge-success" data-editor-target="unsaved">Saved</span></div>
                    {{ form_row(form.title, {attr: {'data-action': 'input->editor#changed'}}) }}
                    {{ form_row(form.description, {attr: {'data-action': 'input->editor#changed', rows: 2}}) }}
                    {{ form_row(form.tagsText, {attr: {'data-action': 'input->editor#changed'}}) }}
                    {{ form_widget(form.revision) }}
                    <div role="tablist" aria-label="Source editors" class="tabs tabs-border mt-4">
                        {% for tab, label in {twig: 'Twig', javascript: 'JavaScript', props: 'Props', examples: 'Examples'} %}
                            <button type="button" role="tab" id="tab-{{ tab }}" aria-controls="panel-{{ tab }}" class="tab" data-tab="{{ tab }}" data-editor-target="tab" data-action="editor#tabClick keydown->editor#tabKey">{{ label }}</button>
                        {% endfor %}
                    </div>
                    <div class="mt-4" role="tabpanel" id="panel-twig" aria-labelledby="tab-twig" data-panel="twig" data-editor-target="panel">
                        <label for="twig-file">Twig file</label><select id="twig-file" class="select select-bordered mb-3 w-full" data-editor-target="twigFile" data-action="editor#fileChanged"></select>
                        <label for="twig-editor">Twig source</label><textarea id="twig-editor" class="textarea textarea-bordered w-full font-mono text-sm" rows="18" spellcheck="false" data-editor-target="twig" data-action="input->editor#sourceChanged"></textarea>
                    </div>
                    <div class="mt-4" role="tabpanel" id="panel-javascript" aria-labelledby="tab-javascript" data-panel="javascript" data-editor-target="panel" hidden>
                        <label for="js-file">JavaScript file</label><select id="js-file" class="select select-bordered mb-3 w-full" data-editor-target="jsFile" data-action="editor#fileChanged"></select>
                        <label for="js-editor">Stimulus source</label><textarea id="js-editor" class="textarea textarea-bordered w-full font-mono text-sm" rows="18" spellcheck="false" data-editor-target="javascript" data-action="input->editor#sourceChanged"></textarea>
                        <button class="btn btn-ghost btn-sm mt-3" type="button" data-action="editor#addController">Add Stimulus controller</button>
                    </div>
                    <div class="mt-4" role="tabpanel" id="panel-props" aria-labelledby="tab-props" data-panel="props" data-editor-target="panel" hidden>
                        <label for="schema-editor">Props schema JSON</label><textarea id="schema-editor" class="textarea textarea-bordered w-full font-mono text-sm" rows="10" data-editor-target="schema" data-action="input->editor#sourceChanged"></textarea>
                        <label for="defaults-editor" class="mt-4">Default props JSON</label><textarea id="defaults-editor" class="textarea textarea-bordered w-full font-mono text-sm" rows="5" data-editor-target="defaults" data-action="input->editor#sourceChanged"></textarea>
                        <div class="mt-4 grid gap-3" data-preview-target="propForm" aria-label="Preview property fields"></div>
                        <label for="preview-props" class="mt-4">Preview props (JSON)</label><textarea id="preview-props" class="textarea textarea-bordered w-full font-mono text-sm" rows="5" data-preview-target="props" data-action="input->preview#schedule"></textarea>
                        <p class="mt-2 text-xs">Preview props are transient. Save renderer settings to restore them on reload.</p>
                    </div>
                    <div class="mt-4" role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" data-panel="examples" data-editor-target="panel" hidden>
                        <label for="examples-editor">Examples JSON</label><textarea id="examples-editor" class="textarea textarea-bordered w-full font-mono text-sm" rows="16" data-editor-target="examples" data-action="input->editor#sourceChanged"></textarea>
                        <label class="mt-4" for="example-select">Preview example</label><select id="example-select" class="select select-bordered w-full" data-preview-target="example" data-action="preview#chooseExample"></select>
                    </div>
                    <p class="mt-3 text-sm text-error" role="alert" tabindex="-1" data-editor-target="notice"></p>
                    <details class="mt-5 rounded-box border border-base-300 p-3">
                        <summary class="cursor-pointer font-semibold">Advanced JSON</summary>
                        {{ form_row(form.manifestJson, {attr: {'data-action': 'input->editor#rawChanged'}}) }}
                        {{ form_row(form.sourceMapJson, {attr: {'data-action': 'input->editor#rawChanged'}}) }}
                    </details>
                    <button type="submit" class="btn btn-primary mt-5">Save draft</button>
                {{ form_end(form) }}
            </section>
            <section class="min-w-0 rounded-box border border-base-300 bg-base-100 p-5">
                <h2 class="text-xl font-semibold">Isolated preview</h2>
                <div class="my-4 flex flex-wrap gap-2" role="group" aria-label="Viewport presets">
                    {% for width in [375, 768, 1280] %}<button type="button" class="btn btn-sm" data-width="{{ width }}" data-action="preview#widthPreset">{{ width }} px</button>{% endfor %}
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="sm:col-span-2"><label for="renderer-theme">Published theme</label><select id="renderer-theme" class="select select-bordered w-full" data-preview-target="theme" data-action="preview#themeChanged"><option value="">Package default (studio light if absent)</option>{% for id, choice in themeChoices %}<option value="{{ id }}">{{ choice.label }}</option>{% endfor %}</select></div>
                    <div><label for="renderer-scheme">Colour scheme</label><select id="renderer-scheme" data-preview-target="colorScheme" data-action="preview#typographyChanged"><option value="theme">Theme default</option><option value="light">Light</option><option value="dark">Dark</option></select></div>
                    <div><label for="renderer-surface">Preview surface</label><select id="renderer-surface" data-preview-target="surface" data-action="preview#typographyChanged"><option value="base-100">Base 100</option><option value="base-200">Base 200</option><option value="transparent">Transparent</option></select></div>
                    <label><input type="checkbox" class="checkbox" data-preview-target="deviceFrame" data-action="preview#viewportChanged"> Device frame</label>
                    <label>Viewport width<input class="input input-bordered w-full" type="number" min="320" max="1920" data-preview-target="width" data-action="input->preview#viewportChanged"></label>
                    <div><label for="renderer-zoom">Zoom</label><select id="renderer-zoom" class="select select-bordered w-full" data-preview-target="zoom" data-action="preview#viewportChanged">{% for zoom in [50, 75, 100] %}<option value="{{ zoom }}">{{ zoom }}%</option>{% endfor %}</select></div>
                    <label>Root font size<input class="input input-bordered w-full" type="number" min="12" max="24" data-preview-target="rootSize" data-action="input->preview#typographyChanged"></label>
                    <div><label for="renderer-text">Default text size</label><select id="renderer-text" class="select select-bordered w-full" data-preview-target="textClass" data-action="preview#typographyChanged">{% for size in ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl'] %}<option value="{{ size }}">{{ size }}</option>{% endfor %}</select></div>
                    {% for key, label in {bodyFont: 'Body font', headingFont: 'Heading font', codeFont: 'Code font'} %}<div><label for="renderer-{{ key }}">{{ label }}</label><select id="renderer-{{ key }}" class="select select-bordered w-full" data-preview-target="{{ key }}" data-action="preview#typographyChanged"><option value="system-sans">System sans</option><option value="system-serif">System serif</option><option value="system-mono">System monospace</option><option value="theme">Theme default</option>{% for id,font in fontFamilies %}<option value="{{ id }}">{{ font.family }}</option>{% endfor %}</select></div>{% endfor %}
                </div>
                <p class="mt-3 text-xs">Root font size also scales rem-based spacing. Zoom changes visual scale; it preserves the CSS viewport width.</p>
                <div class="my-4 flex flex-wrap items-center gap-3">
                    <button class="btn btn-primary btn-sm" type="button" data-action="preview#run">Build preview</button>
                    <button class="btn btn-ghost btn-sm" type="button" data-action="preview#reset">Reset preview</button>
                    <button class="btn btn-ghost btn-sm" type="button" data-action="preview#resetSettings">Reset settings</button>
                    <button class="btn btn-ghost btn-sm" type="button" data-action="preview#resetProps">Reset to example</button>
                    <button class="btn btn-outline btn-sm" type="button" data-action="preview#savePreset">Save renderer settings</button>
                    <label class="flex items-center gap-2"><input type="checkbox" class="checkbox" data-preview-target="disableJs" data-action="preview#toggleScripts">Disable preview scripts</label>
                </div>
                <p class="text-sm" role="status" data-preview-target="presetStatus"></p>
                <p class="my-4 rounded-box bg-base-200 p-3 text-sm" role="status" aria-live="polite" data-preview-target="status">No preview yet</p>
                <div class="max-w-full overflow-auto rounded-box border border-base-300"><div data-preview-target="stage"><iframe title="Component preview" sandbox="allow-scripts" style="height:250px;border:0" data-preview-target="frame"></iframe></div></div>
                <p class="mt-4 text-xs">Source saves and preview jobs are separate. Publish validated immutable releases from the item detail page.</p>
            </section>
        </div>
    </div>
{% endblock %}
