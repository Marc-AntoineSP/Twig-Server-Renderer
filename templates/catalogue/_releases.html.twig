    <details id="releases" class="rounded-box border border-base-300 bg-base-100 p-4">
        <summary class="cursor-pointer font-semibold">Releases & downloads ({{ releases|length }})</summary>
        {% for release in releases %}
        <article class="mt-5 rounded border border-base-300 p-4" data-controller="package-export" data-package-export-url-value="{{ path('package_export_api') }}" data-package-export-csrf-value="{{ csrf_token('api') }}" data-package-export-release-value="{{ release.id }}">
            <p class="font-semibold">{{ release.version }} · {{ release.createdAt|date('Y-m-d') }}</p><a class="link my-2 block" href="{{ path('catalogue_show', {id: item.id, release: release.id, returnTo: listing_return('catalogue_index')}) }}">Preview release {{ release.version }}</a><div data-controller="clipboard"><label for="install-{{ release.id }}">Installation command for {{ release.version }}</label><input class="input w-full font-mono" id="install-{{ release.id }}" readonly data-clipboard-target="command" value="php bin/console styleguide:require {{ item.name }}@{{ release.version }} --registry=local"><button class="btn btn-ghost btn-sm" type="button" data-action="clipboard#copy">Copy installation command {{ release.version }}</button><p role="status" data-clipboard-target="status"></p><p class="my-2 text-sm">Configure your private registry as the local alias first. Store its token outside the consumer project.</p></div>
            <a class="link my-3 block" href="{{ path('release_source_download',{id:release.id}) }}">Download immutable source ZIP</a>
            <label for="format-{{ release.id }}">Export format for {{ release.version }}</label><select id="format-{{ release.id }}" class="select my-2 w-full" data-package-export-target="format"><option value="source">Source package ZIP</option><option value="collection">Resolved collection ZIP (complete dependency closure)</option>{% if item.kind != 'theme' %}<option value="static">Static HTML snapshot (compiled CSS/JS)</option>{% endif %}<option value="json">Canonical JSON envelope</option><option value="yaml">YAML envelope</option></select>
            {% if item.kind != 'theme' %}<label for="export-theme-{{ release.id }}">Optional immutable theme for {{ release.version }}</label><select id="export-theme-{{ release.id }}" class="select my-2 w-full" data-package-export-target="theme"><option value="">Release default</option>{% for theme in exportThemes %}<option value="{{ theme.id }}">{{ theme.theme.name }}@{{ theme.version }}</option>{% endfor %}</select><details class="my-2"><summary>Static snapshot props</summary><label for="export-props-{{ release.id }}">Props for {{ release.version }} (JSON)</label><textarea id="export-props-{{ release.id }}" class="textarea w-full font-mono" rows="5" data-package-export-target="props">{{ release.manifestData.defaults|json_encode }}</textarea></details>{% endif %}
            <p class="my-2 text-sm">Source files require consumer compilation. Static snapshots embed compiled assets. Collections include exact archives and licences. Downloads are private and expire after 30 minutes.</p>
            <button class="btn btn-outline" type="button" data-action="package-export#build">Build export {{ release.version }}</button><p role="status" class="my-2 break-all" data-package-export-target="status"></p><a hidden class="link" data-package-export-target="link">Download ready export</a>
        </article>
        {% else %}<p class="mt-3">No published releases.</p>{% endfor %}
        {% if is_granted('ROLE_EDITOR') and item.kind != 'theme' %}
        <form action="{{ path('release_publish', {id: item.id}) }}" method="post" class="mt-5" data-turbo="false" data-controller="publication" data-action="submit->publication#submit">
            <input type="hidden" name="_token" value="{{ csrf_token('publish') }}"><input type="hidden" name="revision" value="{{ draft.revision }}" data-publication-target="revision">
            <label for="release-version">Release version</label><input id="release-version" name="version" value="{{ draft.manifestData.version }}" required pattern="[0-9]+\.[0-9]+\.[0-9]+" aria-describedby="publication-guidance" data-publication-target="version">
            <p id="publication-guidance" class="my-2 text-sm">Validates defaults and up to 20 examples with the isolated renderer and compiler. Publishing runs in this request; keep this page open until it finishes. Existing versions cannot be replaced.</p>
            <p class="my-2 text-sm">If the connection is lost, reload this page and check the version in Releases before retrying. Leaving the page does not confirm cancellation.</p>
            <button class="btn btn-outline" type="submit" data-publication-target="button">Publish release</button>
            <p class="my-2 text-sm" role="status" data-publication-target="status" hidden></p>
        </form>
        {% endif %}
    </details>
