{% extends 'base.html.twig' %}
{% block title %}Font library · Styleguide Studio{% endblock %}
{% block body %}
<h1 class="text-3xl font-bold">Local font library</h1>
<p class="my-3">{{ allFamilies|length }} installed families for body text, headings and code. Character maps and Unicode ranges were checked for French and English. Font choice alone does not guarantee accessibility.</p>
{% set filters = {q: query.q, category: query.category} %}
{% embed 'discovery/_listing.html.twig' with {route: 'font_index', frameId: 'font-results', label: 'Font', searchLabel: 'Search families', submitLabel: 'Find fonts', singular: 'family', plural: 'families', filterLabels: {q: 'Search', category: 'Category'}} %}
{% block fields %}
<div class="my-0 min-w-0"><label for="font-category">Category</label><select class="min-w-0 p-2 text-sm" id="font-category" name="category"><option value="">All categories</option><option value="sans" {{ query.category == 'sans' ? 'selected' : '' }}>Sans-serif</option><option value="serif" {{ query.category == 'serif' ? 'selected' : '' }}>Serif</option><option value="mono" {{ query.category == 'mono' ? 'selected' : '' }}>Monospace</option><option value="display" {{ query.category == 'display' ? 'selected' : '' }}>Display</option></select></div>
{% endblock %}
{% block results %}
<div class="grid gap-4 md:grid-cols-3">{% for id, family in families %}<article class="card border border-base-300 p-4" data-font-family="{{ id }}" data-family="{{ family.family|lower }}" data-category="{{ family.category }}">
    <h2 class="text-xl font-semibold">{{ family.family }}</h2><p>{{ family.category }} · {{ family.faces|length }} WOFF2 subset faces</p>
    <p>{% set seen = [] %}{% for face in family.faces %}{% set label = face.weightMin ~ (face.weightMax != face.weightMin ? '–' ~ face.weightMax : '') ~ ' ' ~ face.style %}{% if label not in seen %}{{ label }}{% set seen = seen|merge([label]) %}{% if not loop.last %} · {% endif %}{% endif %}{% endfor %}</p>
    <details class="mt-2"><summary>Source and licence</summary><p><a class="link" href="{{ family.source }}" rel="noreferrer">{{ family.package }} {{ family.sourceVersion }}</a> · {{ family.license }}</p><p>{{ family.attribution }}</p><a class="link" href="{{ path('font_asset', {hash:family.licenseSha256, extension:'txt'}) }}">Read local licence</a><p>Google Fonts revision {{ family.upstream.revision|slice(0,12) }}. Actual glyph coverage verified.</p></details>
</article>{% else %}<p class="rounded-box bg-base-100 p-6">No font families match this search and category.</p>{% endfor %}</div>
{% endblock %}
{% endembed %}
<p class="my-4"><a class="link" href="{{ path('theme_new') }}#font-pairing">Pair body, heading and code fonts in a new theme</a>. Existing themes have the same proposal workspace in Edit theme.</p>
{% include 'font/_specimen.html.twig' with {families: allFamilies} %}
{% endblock %}
